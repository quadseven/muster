# Every setting the server reads, with a placeholder where one is needed.
# Copy to .env (or set in the environment) and replace each placeholder.
# README.md says which are required; the rest default as shown.

# ---- required: the server refuses to start without these ------------------

# Administrator sign-in at an OIDC provider (docs/administrator-sign-in.md).
MUSTER_OIDC_ISSUER=https://YOUR_PROVIDER.invalid/
MUSTER_OIDC_JWKS_URL=https://YOUR_PROVIDER.invalid/.well-known/jwks.json
MUSTER_OIDC_AUTHORIZE_URL=https://YOUR_PROVIDER.invalid/oauth2/authorize
MUSTER_OIDC_TOKEN_URL=https://YOUR_PROVIDER.invalid/oauth2/token
MUSTER_OIDC_CLIENT_ID=YOUR_CLIENT_ID_HERE
# Comma-separated `sub` claims allowed to vouch for devices. Never empty.
MUSTER_ADMIN_SUBJECTS=YOUR_SUBJECT_CLAIM_HERE

# The CA key pair (server/tools/bootstrap_ca.py, docs/offline-root-ceremony.md).
MUSTER_CA_KEY=/etc/muster/ca/key.pem
MUSTER_CA_CERT=/etc/muster/ca/cert.pem

# The address devices enroll against, and that the provisioning QR carries.
MUSTER_BASE_URL=https://muster.YOUR_DOMAIN_HERE.invalid

# Plain http URLs stamped into every certificate; each hostname is one this
# server answers on (api.py explains why they must not be https).
MUSTER_CRL_URL=http://crl.YOUR_DOMAIN_HERE.invalid/
MUSTER_OCSP_URL=http://ocsp.YOUR_DOMAIN_HERE.invalid/

# ---- optional ---------------------------------------------------------------

# Where the provider ends its own session on sign-out. Empty: muster's only.
MUSTER_OIDC_END_SESSION_URL=
# Confidential-client secret, if the provider issued one. Empty: public client.
MUSTER_OIDC_CLIENT_SECRET=

# The kith store. Unset: held in memory, lost on restart.
MUSTER_DATABASE_URL=postgresql://USER:PASSWORD@db.YOUR_DOMAIN_HERE.invalid:5432/muster

# Policy files a device fetches (docs/policy.md). Unset: nothing is configured.
MUSTER_POLICY_DIR=/etc/muster/policy
# Operator files a device may fetch: wallpaper, APKs. Unset: no asset store.
MUSTER_ASSET_DIR=/var/lib/muster/assets
# The agent APK served at /agent.apk. Unset: none is published.
MUSTER_AGENT_APK=/app/agent/muster-agent.apk

# Off only for a laptop on plain http.
MUSTER_COOKIE_SECURE=true
# Python logging level for the JSON log on stdout.
MUSTER_LOG_LEVEL=INFO

# Emit a zero-valued check-in count at this interval, in seconds.
MUSTER_CHECK_IN_METRIC_INTERVAL_S=60
# Mark a device stale after this many of its reported check-in periods.
MUSTER_CHECK_IN_STALE_AFTER_PERIODS=3

# DogStatsD. Unset: telemetry is a no-op.
DD_AGENT_HOST=
DD_ENV=
DD_SERVICE=muster
