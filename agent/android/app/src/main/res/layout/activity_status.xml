<?xml version="1.0" encoding="utf-8"?>
<!--
  What this device is. The headline is the largest thing on the screen because
  it is the only line most people will read: everything below it is for whoever
  is troubleshooting, and they will scroll.
-->
<!--
  fitsSystemWindows, or the top of this screen draws UNDER the app bar.
  targetSdk 36 means Android 15 and later enforce edge-to-edge, so the
  window extends behind the system bars and a layout that does not inset
  itself loses its first lines. Measured: the headline rendered at
  y=63..163 while the app bar occupied y=170..241, so the one line the
  screen exists to deliver was invisible and looked like a scroll bug.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:padding="24dp">

    <!--
      focusableInTouchMode keeps the ScrollView from jumping to the button on
      layout. Kept, but it was NOT the cause of the headline being invisible -
      that was the window insets above, and this was a guess that happened to be
      harmless. Diagnosed properly with a uiautomator dump.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <TextView
            android:id="@+id/headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="15sp" />

        <Button
            android:id="@+id/sync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/status_sync" />

        <!-- Shown only when there is genuinely nothing to enroll with. -->
        <Button
            android:id="@+id/enroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:text="@string/status_enroll" />

        <LinearLayout
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
