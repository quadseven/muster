<?xml version="1.0" encoding="utf-8"?>
<!-- The secondary action: an outline, so it cannot compete with the amber. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/muster_hairline" />
            <stroke android:width="1dp" android:color="@color/muster_ink_faint" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/muster_hairline" />
        </shape>
    </item>
</selector>
